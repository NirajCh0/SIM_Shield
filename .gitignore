# ============================================================================
# SIMShield — files that must never enter source control or a distribution.
# Rationale in SECURITY_REMEDIATION.md (finding F8).
# ============================================================================

# --- secrets / key material -------------------------------------------------
backend/data/secret.key
*.key
*.pem
.env
.env.*
!.env.example

# --- generated databases ----------------------------------------------------
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite
backend/data/*.sqlite3

# --- runtime logs and audit trail ------------------------------------------
backend/data/*.log
backend/data/audit.log
backend/data/alerts.log
backend/data/audit.checkpoints

# --- consented research data (never distribute) -----------------------------
backend/data/study/
backend/data/exports/
*.csv.export

# --- generated evaluation output -------------------------------------------
backend/data/evaluation_report.json
backend/data/ml_evaluation_report.json
backend/data/operator_degradation.json
backend/data/monitoring_report.json
backend/data/operator_eval_audit.log

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# --- editors / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================================================================
# NOT ignored, and deliberately so:
#   backend/data/users/*.json   synthetic demo profiles (no real person)
#   backend/models/*.joblib     trained artefacts + models/manifest.json
#   backend/data/sim_swap_fraud_dataset_100000.csv  public synthetic dataset
# ============================================================================
