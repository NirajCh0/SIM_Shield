# ============================================================================
# SIMShield configuration — copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#   python -c "import secrets;print(secrets.token_urlsafe(48))"   # for secrets
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"  # AES key
# ============================================================================

# --- environment -------------------------------------------------------------
# development | demo | production
#   development  debug off, relaxed CORS to localhost, demo endpoints ON
#   demo         public-facing demonstration; OTPs may be revealed IF
#                SIMSHIELD_DEMO_REVEAL_OTP=true is also set explicitly
#   production   refuses to start if any demo/unsafe setting is enabled
SIMSHIELD_ENV=development

# --- secrets (REQUIRED in production; auto-generated ONLY in development) ----
# 32 bytes, base64. Encrypts phone numbers and trusted contacts at rest.
SIMSHIELD_AES_KEY=

# High-entropy secret keying the HMAC used for pseudonymisation.
# Changing it breaks correlation with previously written audit records.
SIMSHIELD_PSEUDONYM_SECRET=

# Flask session signing secret.
SIMSHIELD_SECRET_KEY=

# --- CORS ---------------------------------------------------------------------
# Comma-separated exact origins. Empty = same-origin only (recommended).
# Wildcards are rejected in production.
SIMSHIELD_CORS_ORIGINS=

# --- HTTPS --------------------------------------------------------------------
# Set true ONLY when served over TLS. Enables HSTS and Secure cookies.
SIMSHIELD_HTTPS=false

# --- demo controls (ignored outside demo/development) -------------------------
# Reveals one-time codes in API responses so the sign-in flow can be shown
# WITHOUT a mail server. Leave this TRUE for local use.
#
# No email is ever sent unless you configure SMTP below. With this set to false
# and no SMTP configured, the code goes nowhere and you cannot sign in at all —
# which is exactly what happened to the first person who followed this file.
#
# Production refuses to start if this is true.
SIMSHIELD_DEMO_REVEAL_OTP=true

# Enables /api/score, /api/scenarios and the synthetic profile endpoints.
SIMSHIELD_ENABLE_DEMO_ENDPOINTS=true

# --- optional: real email delivery (otherwise the outbox is simulated) --------
SIMSHIELD_SMTP_HOST=
SIMSHIELD_SMTP_PORT=587
SIMSHIELD_SMTP_USER=
SIMSHIELD_SMTP_PASS=

# --- server -------------------------------------------------------------------
SIMSHIELD_HOST=127.0.0.1
SIMSHIELD_PORT=5000
